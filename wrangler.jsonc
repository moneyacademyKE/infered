{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "infered-virtual-router",
  "main": "src/worker.js",
  "compatibility_date": "2024-09-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "INFERHUB_BASE_URL": "https://api.inferhub.dev/v1",
    "ROUTING_POLICY": "sol-budget-cascade",
    "MAX_FALLBACK_PRICE": "0.10",
    "PRICE_WEIGHT": "0.6",
    "SPEED_WEIGHT": "0.2",
    "QUALITY_WEIGHT": "0.2",
    "PRICE_CACHE_TTL_SEC": "60"
  },
  "d1_databases": [
    {
      "binding": "ROUTING_DB",
      "database_name": "infered-routing",
      "database_id": "b8c91497-e416-4315-8dba-256f9f5652b0"
    }
  ]
}
